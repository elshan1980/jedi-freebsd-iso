# === Sith profile: Lenovo LOQ 15IRX9 ===
# Review each setting and merge it into /etc/rc.conf; do not replace that file.

hostname="Sith"

# Graphics modules from the current FreeBSD graphics profile.
# Confirm support against the installed FreeBSD release and the exact hardware.
kld_list="i915kms nvidia-drm"

# Network interface names vary. Wi-Fi also needs credentials in
# /etc/wpa_supplicant.conf before this can connect.
wlans_iwlwifi0="wlan0"
ifconfig_wlan0="WPA DHCP"
ifconfig_re0="DHCP"

# CPU power management. Review behavior on the target system.
performance_cx_lowest="Cmax"
economy_cx_lowest="Cmax"
powerd_enable="YES"
powerd_flags="-a hiadaptive -b adaptive"

# Audio, touchpad, camera, and Intel CPU microcode.
snd_hda_load="YES"
hw.psm.elantech_support="1"
webcamd_enable="YES"
microcode_update_enable="YES"

# Enable only when the installed system uses ZFS.
# zfs_enable="YES"

# Enable only when remote SSH access is not needed.
# sshd_enable="NO"

clear_tmp_enable="YES"
dumpdev="AUTO"
